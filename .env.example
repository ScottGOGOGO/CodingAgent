AGENT_SERVICE_URL=http://127.0.0.1:8001
AGENT_SERVICE_TIMEOUT_MS=420000
# Set AGENT_SERVICE_TIMEOUT_MS=0 to disable the orchestrator-side request timeout
# and the local Undici headers/body timeout window entirely.
ORCHESTRATOR_PORT=4000
PLAYGROUND_PORT=5173
VITE_API_BASE=http://127.0.0.1:4000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/vide_agent
PROJECTS_ROOT=./data/projects
RUNNER_STRATEGY=auto
MODEL_PROVIDER=openai_compatible
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
CLARIFIER_MODEL=
PLANNER_MODEL=
CODER_MODEL=
CRITIC_MODEL=
MODEL_WIRE_API=
MODEL_REASONING_EFFORT=
MODEL_VERBOSITY=
MODEL_DISABLE_RESPONSE_STORAGE=false
MODEL_TIMEOUT_SECONDS=90
# Set MODEL_TIMEOUT_SECONDS=0 only if you want the agent runtime to wait
# indefinitely for each model stage.
AGENT_MODEL_TURN_TIMEOUT_SECONDS=90
# Hard timeout for each tool-use coder turn. Values <=0 still fall back to 90s
# so the generator fails clearly instead of hanging indefinitely.
AGENT_MAX_TURNS=50
AGENT_MAX_TOOL_CALLS_PER_TURN=6
AGENT_MAX_TOOL_CALLS_TOTAL=300
# Strict commercial smoke runs should usually raise these agent-loop budgets,
# for example 90 turns / 8 tools per turn / 520 total tool calls.
AGENT_STRICT_GENERATION=false
# Set AGENT_STRICT_GENERATION=true for commercial reliability runs. Strict mode
# fails instead of replacing incomplete/model-failed generations with fallback candidates.
AGENT_SKIP_ACCEPTANCE=false
# Set AGENT_SKIP_ACCEPTANCE=true only for local preview-first debugging. It skips
# final candidate validation before candidate approval.

# Optional provider-specific blocks. If MODEL_* is empty, the runtime uses the
# block selected by MODEL_PROVIDER, or auto-picks the first complete block when
# MODEL_PROVIDER=openai_compatible.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-coder-plus
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# For GPT-5.x on Responses-compatible endpoints, recommended starting values:
# MODEL_WIRE_API=responses
# MODEL_REASONING_EFFORT=low
# MODEL_VERBOSITY=low
# MODEL_DISABLE_RESPONSE_STORAGE=true

GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=

CLAUDE_API_KEY=
CLAUDE_BASE_URL=
CLAUDE_MODEL=


Deep_API_KEY=sk-8da1bfadbe1f4edab475799242c1c680
CLAUDE_BASE_URL=https://api.deepseek.com
CLAUDE_MODEL=deepseek-v4-flash
