{
  "name": "@vide/orchestrator-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --workspace @vide/agent-runtime run build && tsc -p tsconfig.json",
    "dev": "npm --workspace @vide/agent-runtime run build && npm --workspace @vide/orchestrator-api run dev:prepared",
    "dev:prepared": "tsx watch --exclude '../../packages/agent-runtime/dist/**' --exclude '../../packages/contracts/dist/**' src/index.ts",
    "start": "node dist/index.js",
    "test": "npm --workspace @vide/agent-runtime run build && node --import tsx --test src/*.test.ts src/**/*.test.ts",
    "typecheck": "npm --workspace @vide/agent-runtime run build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vide/agent-runtime": "0.1.0",
    "@fastify/cors": "^11.0.0",
    "@vide/contracts": "0.1.0",
    "fastify": "^5.0.0",
    "pg": "^8.0.0",
    "undici": "^7.24.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
